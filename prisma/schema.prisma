generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  passwordHash String
  // Soft-disable instead of deleting a user, so their audit log history
  // (attributed by denormalized name/email, not a live FK) stays intact
  // and their account can't sign in without deleting the trail of what
  // they did while it existed.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// Who did what, for security/audit review. Deliberately logs key events
// (create, delete, significant status changes) rather than every field
// edit -- an auditor asks "who created/deleted/approved this," not "who
// edited this textarea." userId/userEmail/userName are captured at write
// time rather than joined live, so the trail survives a user being
// deactivated or a record being deleted.
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String
  userName    String
  action      String // "create" | "delete" | "status_change"
  entityType  String // "Lead" | "Contact" | "Company" | "Deal" | "Project" | "Invoice"
  entityId    String
  entityLabel String
  detail      String   @default("")
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Records a failed login attempt for basic brute-force throttling. Stored
// in the DB rather than in-memory since serverless invocations don't share
// process memory -- a counter in a route handler wouldn't survive between
// requests on Vercel. Only failures are recorded; a successful login clears
// the count for that email.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Lead {
  id             String    @id @default(cuid())
  name           String
  company        String
  email          String
  message        String
  source         String
  receivedAt     DateTime  @default(now())
  status         String    @default("new") // new | in_pipeline | closed
  // Free-text note on why a lead was closed (e.g. "Disqualified", "Not a
  // fit", "No response") -- kept as an open field rather than a fixed set
  // of reasons, same tradeoff as Deal.closedLostReason.
  closedReason   String    @default("")
  nextFollowUpAt DateTime?
  // Stable identifier for rows pulled in from an external source (e.g. a
  // Google Sheet tab + row timestamp + email), used to avoid re-importing
  // the same row on every sync. Null for leads created manually or via CSV.
  sourceRef      String?   @unique
  createdAt      DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

// A company/organization, grouping the contacts, deals, and invoices
// associated with it. Contact/Deal/Invoice keep their own free-text
// company/client name (used as-is by CSV import, the webhook payload,
// and reports) -- companyId is a best-effort link set automatically
// (find-or-create by name) whenever one of those records is created.
model Company {
  id                   String    @id @default(cuid())
  name                 String
  website              String    @default("")
  notes                String    @default("")
  // Optional, progressive-disclosure detail -- not shown until set.
  industry             String    @default("")
  companySize          String    @default("")
  governmentContractor Boolean   @default(false)
  icpTier              String    @default("")
  // Which of this company's contacts is the main point of contact. A
  // separate relation from Contact.companyId ("belongs to this company")
  // -- named explicitly since Prisma can't infer which of two relations
  // between the same two models a field belongs to.
  primaryContactId     String?
  primaryContact       Contact?  @relation("CompanyPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  contacts             Contact[] @relation("CompanyContacts")
  deals                Deal[]
  invoices             Invoice[]
  projects             Project[]
  activities           Activity[]
  createdAt            DateTime  @default(now())
}

model Contact {
  id                String     @id @default(cuid())
  name              String
  company           String
  companyId         String?
  companyRecord     Company?   @relation("CompanyContacts", fields: [companyId], references: [id], onDelete: SetNull)
  primaryContactFor Company[]  @relation("CompanyPrimaryContact")
  email             String
  phone             String
  title             String
  nextFollowUpAt    DateTime?
  marketingConsent  Boolean    @default(false)
  activities        Activity[]
  deals             Deal[]
  projects          Project[]
  projectStakeholderFor ProjectStakeholder[]
  createdAt         DateTime   @default(now())
}

model Deal {
  id                String     @id @default(cuid())
  title             String
  company           String
  companyId         String?
  companyRecord     Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactName       String
  contactId         String?
  contactRecord     Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  value             Float      @default(0)
  stage             String     @default("Lead") // Lead | Qualified | Proposal | Negotiation | Won | Lost
  closeDate         DateTime?
  notes             String     @default("")
  // Customer-facing description of what the engagement covers -- shown
  // on the printable quote. Kept separate from internal notes above.
  scopeOfWork       String     @default("")
  nextStep          String     @default("")
  nextStepDueAt     DateTime?
  revenueStream     String     @default("")
  closedLostReason  String     @default("")
  probability       Int        @default(0)
  // Quote document settings. quoteType picks the layout (service:
  // Deliverable/Type/Amount vs subscription: Item/Seats/Billing/Unit
  // Price/Total). quoteNumber and quoteIssuedAt are assigned once, the
  // first time this deal's quote is viewed, so reprints stay stable.
  quoteType         String     @default("service") // service | subscription
  // Subscription quotes only: the named SaaS product/plan this quote is
  // for (e.g. "RevOps Ledger"), shown as the quote's heading in place of
  // the generic "Subscription Quote" label when set.
  quoteProductName  String     @default("")
  quoteNumber       Int?       @unique
  quoteIssuedAt     DateTime?
  paymentTerms      String     @default("Net 30 from invoice date")
  tasks             Task[]
  activities        Activity[]
  invoices          Invoice[]
  projects          Project[]
  lineItems         QuoteLineItem[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

// A single row on a deal's quote (e.g. a deliverable or a subscription
// item). Deals with none get one synthesized on the fly from title/
// value at render time, so existing deals still produce a usable quote.
model QuoteLineItem {
  id          String  @id @default(cuid())
  dealId      String
  deal        Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  description String  // "Deliverable" (service) or "Item" (subscription)
  // "Type" (service, e.g. "Fixed Fee Project") or "Billing" (subscription,
  // e.g. "Annual" / "One Time") -- just display text, label depends on
  // the deal's quoteType.
  detail      String  @default("")
  seats       Int?    // subscription only; blank/omitted for service rows
  unitPrice   Float?  // subscription only; blank/omitted for service rows
  amount      Float   @default(0)
  order       Int     @default(0)
}

model Task {
  id     String  @id @default(cuid())
  dealId String
  deal   Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  text   String
  done   Boolean @default(false)
  order  Int     @default(0)
}

model Activity {
  id        String   @id @default(cuid())
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ts        DateTime @default(now())
  text      String
  // Who/what logged this: "user" (default), "system" (e.g. lead
  // conversion), "sheet_sync", "webhook" -- lets a future automation or
  // agent identify its own entries without guessing from the text.
  source    String   @default("user")
}

model Project {
  id              String     @id @default(cuid())
  name            String
  client          String
  companyId       String?
  companyRecord   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId       String?
  contactRecord   Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status          String     @default("Not started") // Not started | In progress | Blocked | Complete
  progress        Int        @default(0)
  dueDate         DateTime?
  health          String     @default("Green") // Green | Yellow | Red
  nextDeliverable String     @default("")
  nextMeetingAt   DateTime?
  // Internal working notes -- distinct from the originating deal's
  // customer-facing scopeOfWork, which seeds this on auto-creation.
  notes           String     @default("")
  // Committed budget for the engagement. Defaults from the deal's value
  // when a project is auto-created on Won; editable afterward.
  contractedValue Float      @default(0)
  // Costs/hours actually incurred so far, tracked manually against
  // contractedValue (planned) -- same lightweight "consultant types in a
  // number" approach as contractedValue itself, not a time-tracking system.
  actualCost      Float      @default(0)
  // Set automatically when a Google Drive customer folder is created on
  // deal Won (see lib/googleDrive.ts). Empty until Drive is configured --
  // that integration is best-effort and must never block a deal closing.
  driveFolderUrl  String     @default("")
  dealId          String?
  deal            Deal?      @relation(fields: [dealId], references: [id])
  subtasks        Subtask[]
  activities      Activity[]
  deliverables    Deliverable[]
  milestones      Milestone[]
  risks           RiskLogEntry[]
  stakeholders    ProjectStakeholder[]
  createdAt       DateTime   @default(now())
}

// A named phase/milestone within a project's delivery timeline, so
// progress can be tracked at a coarser grain than individual tasks.
model Milestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  status    String    @default("Not started") // Not started | In progress | Complete
  dueDate   DateTime?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
}

// A lightweight risk register: identified risks/issues per project,
// kept separate from general working notes so they're easy to scan.
model RiskLogEntry {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String
  severity    String   @default("Medium") // Low | Medium | High
  status      String   @default("Open") // Open | Mitigated | Closed
  mitigation  String   @default("")
  createdAt   DateTime @default(now())
}

// Named contacts involved in a project beyond the single primary
// "Contact" field, each with a role (sponsor, approver, day-to-day
// contact, etc.).
model ProjectStakeholder {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      String   @default("")
  createdAt DateTime @default(now())

  @@unique([projectId, contactId])
}

// A dated log of what's actually been delivered on the engagement,
// distinct from the single free-text "next deliverable" field -- that
// one tracks what's coming up, this tracks what's already shipped.
model Deliverable {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  deliveredAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Subtask {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean   @default(false)
  dueDate   DateTime?
  order     Int       @default(0)
}

model Invoice {
  id            String     @id @default(cuid())
  // Sequential, permanent invoice number for bookkeeping records. Assigned
  // once at creation time (unlike Deal.quoteNumber, which is assigned
  // lazily on first quote view -- invoices are created deliberately, so
  // there's no "not yet issued" state to wait out).
  invoiceNumber Int?       @unique
  client        String
  companyId     String?
  companyRecord Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId        String?
  deal          Deal?      @relation(fields: [dealId], references: [id])
  amount        Float      @default(0)
  status        String     @default("Draft") // Draft | Sent | Paid | Overdue
  // Tax/bookkeeping category for revenue-by-category reporting. Mirrors
  // Deal.revenueStream but kept independent -- an invoice can be edited
  // separately from the deal it originated from, and stand-alone invoices
  // have no deal to inherit from.
  revenueStream String     @default("")
  notes         String     @default("")
  issuedAt      DateTime   @default(now())
  dueDate       DateTime?
  // When payment was actually received -- distinct from issuedAt/dueDate,
  // and the field revenue-by-period reporting should key off for accurate
  // cash-basis totals. Set automatically when status flips to "Paid",
  // editable afterward to match the real payment date.
  paidAt        DateTime?
  activities    Activity[]
  createdAt     DateTime   @default(now())
}
