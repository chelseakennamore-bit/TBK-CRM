# Postgres connection string. Get one for free from Neon (https://neon.tech)
# or Supabase (https://supabase.com), or run Postgres locally.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Credentials for the seeded admin user (used by prisma/seed.ts).
# Change these before deploying anywhere public.
ADMIN_EMAIL="admin@tbkconsulting.com"
ADMIN_PASSWORD="changeme123"

# Google Sheets sync (Leads page "Sync now" button). See SHEETS-SETUP.md
# for how to create the service account and get these values.
GOOGLE_SHEETS_SPREADSHEET_ID="paste-the-id-from-the-sheet-url"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
# The private_key field from the service account JSON, base64-encoded as a
# single line (see SHEETS-SETUP.md) — not the raw PEM. This avoids env-var
# UIs mangling the PEM's internal line breaks.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_B64="base64-encoded-private-key"
