# Postgres connection string. Get one for free from Neon (https://neon.tech)
# or Supabase (https://supabase.com), or run Postgres locally.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Credentials for the seeded admin user (used by prisma/seed.ts).
# Change these before deploying anywhere public.
ADMIN_EMAIL="admin@tbkconsulting.com"
ADMIN_PASSWORD="changeme123"
